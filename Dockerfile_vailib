FROM zveronline/sopds:latest

# ============================================================
# VAILIB NATIVE BUILD (Zero-Bind Architecture)
# ============================================================

# Apply backend logic overrides
COPY models.py /sopds/opds_catalog/models.py
COPY opdsdb.py /sopds/opds_catalog/opdsdb.py
COPY opds_catalog_utils.py /sopds/opds_catalog/utils.py
COPY views.py /sopds/sopds_web_backend/views.py

# Apply template theme overrides
COPY templates/ /sopds/sopds_web_backend/templates/
COPY sopds_main.html /sopds/sopds_web_backend/templates/sopds_main.html
COPY sopds_hello.html /sopds/sopds_web_backend/templates/sopds_hello.html
COPY sopds_logo.html /sopds/sopds_web_backend/templates/sopds_logo.html
COPY sopds_menu.html /sopds/sopds_web_backend/templates/sopds_menu.html
COPY sopds_footer.html /sopds/sopds_web_backend/templates/sopds_footer.html

# Apply static web assets
COPY static/custom/ /sopds/static/custom/

# The application executes exactly as the base SOPDS container.
# All customizations are now baked into the image.
