# Stage 1: Extract SOPDS codebase and entrypoint from the base Alpine image
FROM zveronline/sopds:latest AS sopds_base

# Stage 2: Create stable, compatible Debian-based runtime
FROM python:3.10-slim

# Avoid interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies (Calibre, DjVuLibre, Postgres client, expect)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        calibre \
        djvulibre-bin \
        bash \
        psmisc \
        postgresql-client \
        libpq-dev \
        gcc \
        python3-dev \
        curl \
        expect \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create postgres user and group to prevent startup permissions issues in start.sh
RUN groupadd -r postgres && useradd -r -g postgres postgres

# Create state directory for SOPDS setup check
RUN mkdir -p /var/lib/pgsql && chown -R postgres:postgres /var/lib/pgsql

# Copy the entire /sopds directory and start script from base image
COPY --from=sopds_base /sopds /sopds
COPY --from=sopds_base /start.sh /start.sh

# Install Python package dependencies matching base SOPDS
RUN pip install --no-cache-dir \
    Django==2.1.15 \
    psycopg2-binary==2.8.6 \
    python-telegram-bot==13.5 \
    APScheduler==3.6.3 \
    django-picklefield==3.0 \
    lxml==5.2.2 \
    pillow==10.3.0 \
    pytz==2024.1 \
    tzlocal==2.1 \
    tornado==6.4

# Apply backend logic overrides
COPY models.py /sopds/opds_catalog/models.py
COPY opdsdb.py /sopds/opds_catalog/opdsdb.py
COPY opds_catalog_dl.py /sopds/opds_catalog/dl.py
COPY middleware.py /sopds/opds_catalog/middleware.py
COPY opds_catalog_utils.py /sopds/opds_catalog/utils.py
COPY views.py /sopds/sopds_web_backend/views.py
COPY urls.py /sopds/sopds_web_backend/urls.py

# Apply template theme overrides (includes admin dashboard and mobile/e-ink templates)
COPY templates/ /sopds/sopds_web_backend/templates/

# Apply custom template tag library (title cleaning, format color utilities)
COPY templatetags/ /sopds/sopds_web_backend/templatetags/

# Apply Django management commands (fetch_covers, etc.)
COPY management/ /sopds/sopds_web_backend/management/

# Apply static web assets
COPY static/custom/ /sopds/static/custom/

# Add unified services: scanner watcher, bot, and converter
COPY scanner_watcher.sh /scanner_watcher.sh
COPY bot.sh /bot.sh
COPY convert.sh /convert.sh

RUN chmod +x /scanner_watcher.sh /bot.sh /convert.sh && \
    sed -i 's/python3 manage.py sopds_scanner start/python3 manage.py sopds_scanner start \& \/scanner_watcher.sh \& \/bot.sh \& \/convert.sh/g' /start.sh

ENTRYPOINT ["/start.sh"]
