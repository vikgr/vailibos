FROM zveronline/sopds:latest

# ============================================================
# VAILIB NATIVE BUILD (Zero-Bind Architecture - Unified Stack)
# ============================================================

# Install system dependencies for converter and bot (using edge repos for Calibre)
RUN apk update && \
    apk add --no-cache \
        calibre \
        djvulibre \
        bash \
        psmisc \
        postgresql-client \
        curl \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community

# Apply backend logic overrides
COPY models.py /sopds/opds_catalog/models.py
COPY opdsdb.py /sopds/opds_catalog/opdsdb.py
COPY opds_catalog_dl.py /sopds/opds_catalog/dl.py
COPY middleware.py /sopds/opds_catalog/middleware.py
COPY opds_catalog_utils.py /sopds/opds_catalog/utils.py
COPY views.py /sopds/sopds_web_backend/views.py
COPY urls.py /sopds/sopds_web_backend/urls.py

# Apply template theme overrides (includes admin dashboard and mobile/e-ink templates)
COPY templates/ /sopds/sopds_web_backend/templates/

# Apply custom template tag library (title cleaning, format color utilities)
COPY templatetags/ /sopds/sopds_web_backend/templatetags/

# Apply Django management commands (fetch_covers, etc.)
COPY management/ /sopds/sopds_web_backend/management/

# Apply static web assets
COPY static/custom/ /sopds/static/custom/

# Add unified services: scanner watcher, bot, and converter
COPY scanner_watcher.sh /scanner_watcher.sh
COPY bot.sh /bot.sh
COPY convert.sh /convert.sh

RUN chmod +x /scanner_watcher.sh /bot.sh /convert.sh && \
    sed -i 's/python3 manage.py sopds_scanner start/python3 manage.py sopds_scanner start \& \/scanner_watcher.sh \& \/bot.sh \& \/convert.sh/g' /start.sh

# The application executes exactly as the base SOPDS container.
# All customizations, bot logic, and converters are now baked into a single image.
