# Vailib Environment Variables Configuration
# Copy this file to .env and change the values before running docker-compose up -d

# Database Configuration
POSTGRES_USER=sopds
POSTGRES_DB=sopds
DB_PASSWORD=changeme

# Application Configuration
TIME_ZONE=Europe/Madrid

# Paths (Adjust to your host setup)
BOOKS_PATH=/DATA/Downloads/books
DB_DATA_PATH=/DATA/AppData/library/postgres
SOPDS_DATA_PATH=/DATA/AppData/library/sopds-db

# Telegram Bot & PDF Converter
# Obtain these from Telegram by creating a bot via BotFather
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here
