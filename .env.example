# ============================================================
# Vailib Open Source (vailibos) - Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# Network & Web Port
PORT=8081

# PostgreSQL Database Configuration
POSTGRES_USER=sopds
POSTGRES_DB=sopds
DB_PASSWORD=vailib_secure_password_change_me

# Localization & Timezone
TIME_ZONE=Europe/Madrid

# Host Mount Paths (Relative to docker-compose.yml or absolute paths)
BOOKS_PATH=./books
DATA_PATH=./data/sopds
DB_DATA_PATH=./data/postgres

# Telegram Document Assistant & Converter (Optional)
# Can also be configured interactively via Web Setup Wizard (/web/setup/)
BOT_TOKEN=
CHAT_ID=
